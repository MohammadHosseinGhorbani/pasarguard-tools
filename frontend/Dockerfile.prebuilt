# Escape hatch: serve an already-built frontend, no npm on the server.
# Usage (from repo root on your Windows machine, where `npm run build` works):
#   cd frontend && npm run build && cd ..
#   scp -r frontend/dist frontend/nginx.conf <user>@<vps>:<repo>/frontend/
# On the VPS, build with:
#   docker build -f frontend/Dockerfile.prebuilt -t pg-tools-frontend ./frontend
# Or point the compose `frontend.build.dockerfile` at this file temporarily.
FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
